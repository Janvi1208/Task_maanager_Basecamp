# Database connection string.
# SQLite (default, zero-setup, great for local/demo use):
DATABASE_URL=sqlite:///./taskdashboard.db

# To use PostgreSQL instead, comment the line above and use something like:
# DATABASE_URL=postgresql+psycopg2://taskuser:taskpass@localhost:5432/taskdashboard

# Comma-separated list of origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT signing configuration. Replace the development value in real deployments.
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# External public API used for the "Daily Tip" widget on the dashboard.
EXTERNAL_QUOTE_API_URL=https://api.quotable.io/random
EXTERNAL_API_TIMEOUT_SECONDS=4
